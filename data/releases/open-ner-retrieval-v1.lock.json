  "description": "Open mined corpus, full-type NER supervision, source-held-out recognition evidence, and exact terminology/graph retrieval overlays available on 2026-07-22.",
  "rebuild_steps": [
    {
      "command": "uv sync --frozen --extra dev --extra data --extra retrieval --extra ml",
      "description": "Restore the exact Python environment and all local data/model adapters.",
      "id": "install-environment"
    },
    {
      "command": "uv run medical-kg data registry validate --registry data/sources/mining_registry.yaml --processing-index data/sources/processing_status.yaml --repository-root .",
      "description": "Validate source licenses, processing dossiers, and checked-in run configs.",
      "id": "validate-source-policy"
    },
    {
      "command": "uv run medical-kg data run --plan configs/mining/vietbioner.yaml",
      "description": "Restore the immutable Vietnamese source archive and parsed documents.",
      "id": "acquire-vietbioner"
    },
    {
      "command": "uv run medical-kg data run --plan configs/mining/codiesp.yaml",
      "description": "Restore the immutable CodiEsp source archive and parsed documents.",
      "id": "acquire-codiesp"
    },
    {
      "command": "uv run medical-kg data run --plan configs/mining/dailymed-rxnorm-2026-07-17.yaml",
      "description": "Restore the official SPL-to-RxNorm crosswalk.",
      "id": "acquire-dailymed-rxnorm"
    },
    {
      "command": "uv run medical-kg data dataset fuse --plan configs/mining/open_corpus_v1.yaml",
      "description": "Fuse the source-specific curated outputs after following their dossiers.",
      "id": "fuse-open-corpus"
    },
    {
      "command": "uv run medical-kg model inspect-token-classifier-run --config configs/models/open-corpus-full-type-xlmr-base-2026-07-19.yaml",
      "description": "Validate pinned model inputs and print the immutable checkpoint prefetch command.",
      "id": "inspect-full-type-model-run"
    },
    {
      "command": "uv run hf download FacebookAI/xlm-roberta-base --revision e73636d4f797dec63c3081bb6ed5c7b0bb3f2089",
      "description": "Cache the immutable upstream checkpoint before the offline training stage.",
      "id": "prefetch-full-type-model"
    },
    {
      "command": "uv run medical-kg model train-token-classifier-run --config configs/models/open-corpus-full-type-xlmr-base-2026-07-19.yaml",
      "description": "Optionally reproduce the local checkpoint on a compatible Linux/CUDA worker.",
      "id": "train-full-type-model"
    },
    {
      "command": "uv run medical-kg data release verify --manifest data/releases/open-ner-retrieval-v1.lock.json --root .",
      "description": "Verify all restored or rebuilt release bytes without machine-local paths.",
      "id": "verify-release"
    }
  ],
  "release_fingerprint": "e95a1b238137ca4d7e23f113efe92d3e3be8afb0aa43e23f741b76752dd417d2",
  "release_id": "open-ner-retrieval-v1",
  "schema_version": "medical-mining-release-lock.v1",
